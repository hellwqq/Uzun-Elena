## Задание 6
```
localhost:~/practice1# nano comments

#!/bin/bash

find "$1" -type f \( -name "*.c" -o -name "*.js" -o -name "*.py" \) | while read -r file
do
    first=$(head -n 1 "$file")

    if [[ "$first" == \#* || "$first" == //* ]]; then
        echo "$file: comment"
    else
        echo "$file: no comment"
    fi
done

localhost:~/practice1# chmod +x comments
echo '# test' > test.py
echo '# test' > test.py
echo '// test' > test.c
./comments .
# $(...) позволяет взять результат команды и записать его в переменную.
#head начало файла
```
## Задание 7
```
localhost:~/practice1#  nano duplicates

#!/bin/bash

find "$1" -type f -exec md5sum {} \; | sort | awk '{
    if ($1 == old) {
        if (count == 1) print old_file
        print $2
        count++
    } else {
        old = $1
        old_file = $2
        count = 1
    }
}'

